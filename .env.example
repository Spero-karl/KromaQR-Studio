# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Internal preview/service URL injected by runtime (not used for public QR links).
APP_URL="MY_APP_URL"

# PUBLIC_APP_URL: Public HTTPS base URL used for all generated QR code links (/m/:id, /d/:slug).
# Render example: PUBLIC_APP_URL="https://kromaqr-studio.onrender.com"
PUBLIC_APP_URL=""

# Dosya.dev S3-Compatible Object Storage (server-side only, never exposed to frontend)
DOSYA_ENDPOINT="https://api.dosya.dev/s3"
DOSYA_REGION="us-east-1"
DOSYA_BUCKET="ws_DW34yrBK9IcRm1vYQb47G"
DOSYA_ACCESS_KEY_ID=""
DOSYA_SECRET_ACCESS_KEY=""

# Cron & Keep-alive (Render external trigger security)
CRON_SECRET=""

# Admin Pricing Console Passcode (server-side only; if empty, first-run admin claim form is enabled)
ADMIN_PASSCODE=""

# Optional Email Alerts (48h / 24h / expiration opt-in)
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# Radox AI API (server-side only for Step 1 smart example generation, capped at 10 requests/day)
RADOX_AI_API_KEY=""
RADOX_AI_BASE_URL="https://radoxai.com/v1"
RADOX_AI_MODEL="gpt-4o-mini"

